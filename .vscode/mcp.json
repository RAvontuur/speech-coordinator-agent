{
  "servers": {
    "outdoor-ticket-system-mcp": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/outdoor-ticket-system-mcp",
      "env": {
        "OUTDOOR_TICKET_QUEUE_DIR": "${workspaceFolder}/ticket-queue",
        "OUTDOOR_TICKET_ROOT": "${workspaceFolder}/tickets"
      }
    },
    "outdoor-speech": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/bin/outdoor-speech-mcp",
      "env": {
        "AZURE_SPEECH_KEY": "${env:AZURE_SPEECH_KEY}",
        "AZURE_SPEECH_REGION": "${env:AZURE_SPEECH_REGION}",
        "OPENAI_API_KEY": "${env:OPENAI_API_KEY}",
        "OPENAI_MODEL": "${env:OPENAI_MODEL}"
      }
    }
  }
}